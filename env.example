# =============================================================================
# Kirchenplanung — Umgebungsvariablen
# Kopiere diese Datei nach .env und fülle alle Werte aus.
# Die .env-Datei NIEMALS ins Git-Repository committen!
# =============================================================================

# -----------------------------------------------------------------------------
# Datenbank (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=kirchenplanung
POSTGRES_USER=kp_app
POSTGRES_PASSWORD=HIER_SICHERES_PASSWORT_EINSETZEN
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Vollständige Connection-URL (wird von FastAPI/SQLAlchemy verwendet)
DATABASE_URL=postgresql+asyncpg://kp_app:HIER_SICHERES_PASSWORT_EINSETZEN@db:5432/kirchenplanung

# -----------------------------------------------------------------------------
# Applikation (FastAPI)
# -----------------------------------------------------------------------------
# Mindestens 32 zufällige Zeichen — generieren mit:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=HIER_ZUFAELLIGEN_STRING_EINSETZEN

# Umgebung: development | production
APP_ENV=production

# Basis-URL der Applikation (ohne abschliessenden Slash)
APP_BASE_URL=https://kirchenplanung.example.ch

# Debug-Modus (in Production immer False)
DEBUG=False

# -----------------------------------------------------------------------------
# JWT-Konfiguration
# -----------------------------------------------------------------------------
# Token-Lebensdauer in Minuten
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
# Refresh-Token-Lebensdauer in Tagen
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# Backup (Rclone + Infomaniak kDrive)
# -----------------------------------------------------------------------------
# Rclone-Remote-Name (wie in ~/.config/rclone/rclone.conf konfiguriert)
RCLONE_REMOTE=kdrive
# Ziel-Pfad auf kDrive
RCLONE_BACKUP_PATH=kdrive:kirchenplanung-backups

# GPG-Key-ID für Backup-Verschlüsselung
# gpg --list-keys um vorhandene Keys anzuzeigen
GPG_KEY_ID=HIER_GPG_KEY_ID_EINSETZEN

# Lokales Backup-Verzeichnis auf dem VPS
BACKUP_LOCAL_DIR=/var/backups/kirchenplanung

# Aufbewahrungsdauer lokaler Backups in Tagen
BACKUP_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# nginx / TLS
# -----------------------------------------------------------------------------
# Domain für Let's Encrypt Zertifikat
DOMAIN=kirchenplanung.example.ch
# E-Mail für Let's Encrypt Benachrichtigungen
LETSENCRYPT_EMAIL=admin@example.ch

# -----------------------------------------------------------------------------
# Archivierungsjob
# -----------------------------------------------------------------------------
# Aufbewahrungsfenster in Jahren (Daten älter als X Jahre werden archiviert)
ARCHIVE_RETENTION_YEARS=2
# Archiv-Verzeichnis
ARCHIVE_DIR=/var/backups/kirchenplanung/archive
